{
  "name": "video-dedup-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "视频去重工位 Electron 桌面版",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging --remote-debugging-port=9222",
    "test": "node --test lib/__tests__/*.test.js",
    "prepare:python-runtime": "node scripts/prepare-python-runtime.js",
    "prepare:asr-models": "node scripts/prepare-asr-models.js",
    "pack": "electron-builder --dir --win --x64",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "dist:portable": "electron-builder --win portable --x64 --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:mac:x64": "electron-builder --mac x64 --publish never",
    "dist:mac:arm64": "electron-builder --mac arm64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "build": {
    "appId": "com.videoUniqueness.desktop",
    "productName": "视频去重工位",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "!lib/__tests__/**",
      "build/runtime-config.bin",
      "package.json"
    ],
    "beforePack": "scripts/before-pack.js",
    "extraResources": [
      {
        "from": "build",
        "to": "build",
        "filter": [
          "icon.ico",
          "icon.png"
        ]
      },
      {
        "from": "../../archive/web",
        "to": "archive/web",
        "filter": [
          "index.html",
          "app.js",
          "style.css",
          "!README*",
          "!*.map"
        ]
      },
      {
        "from": "../server",
        "to": "station/server",
        "filter": [
          "**/*",
          "!.env",
          "!.env.*",
          "!**/.env",
          "!**/.env.*",
          "!logs/**",
          "!__pycache__/**",
          "!*.pyc",
          "!*.pyo",
          "!*.spec",
          "!calibrate_tts_rate.py",
          "!yb_*.png",
          "!yuanbao_page_*.html",
          "!**/*debug*",
          "!**/*test*",
          "!**/*.log"
        ]
      },
      {
        "from": "../shared",
        "to": "station/shared",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/*.log"
        ]
      },
      {
        "from": "../hooks",
        "to": "station/hooks",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/*.log"
        ]
      },
      {
        "from": "../extension",
        "to": "station/extension",
        "filter": [
          "content-yuanbao.js",
          "manifest.json",
          "icons/**"
        ]
      },
      {
        "from": "../vendor",
        "to": "station/vendor",
        "filter": [
          "**/*",
          "!python/**",
          "!asr_models/**",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/*.log"
        ]
      },
      {
        "from": "../vendor/asr_models",
        "to": "station/vendor/asr_models",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../vendor/python",
        "to": "py",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "video-dedup-desktop-setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "video-dedup-desktop-setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "luckly06",
        "repo": "video-mcp",
        "releaseType": "release"
      }
    ],
    "mac": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "zip"
        },
        {
          "target": "dmg"
        }
      ],
      "artifactName": "${productName}-mac-${version}-${arch}.${ext}",
      "category": "public.app-category.video",
      "identity": null
    },
    "asar": true,
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

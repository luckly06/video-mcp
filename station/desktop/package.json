{
  "name": "video-dedup-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "视频去重工位 Electron 桌面版",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging --remote-debugging-port=9222",
    "test": "node --test lib/__tests__/*.test.js",
    "prepare:python-runtime": "node scripts/prepare-python-runtime.js",
    "pack": "electron-builder --dir --win --x64",
    "dist": "electron-builder --win portable --x64"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.videoUniqueness.desktop",
    "productName": "视频去重工位",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "!lib/__tests__/**",
      "build/runtime-config.bin",
      "package.json"
    ],
    "beforePack": "scripts/before-pack.js",
    "extraResources": [
      {
        "from": "build",
        "to": "build",
        "filter": [
          "icon.ico",
          "icon.png"
        ]
      },
      {
        "from": "../../archive/web",
        "to": "archive/web",
        "filter": [
          "index.html",
          "app.js",
          "style.css",
          "!README*",
          "!*.map"
        ]
      },
      {
        "from": "../server",
        "to": "station/server",
        "filter": [
          "**/*",
          "!.env",
          "!.env.*",
          "!**/.env",
          "!**/.env.*",
          "!logs/**",
          "!__pycache__/**",
          "!*.pyc",
          "!*.pyo",
          "!*.spec",
          "!calibrate_tts_rate.py",
          "!yb_*.png",
          "!yuanbao_page_*.html",
          "!**/*debug*",
          "!**/*test*",
          "!**/*.log"
        ]
      },
      {
        "from": "../shared",
        "to": "station/shared",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/*.log"
        ]
      },
      {
        "from": "../hooks",
        "to": "station/hooks",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/*.log"
        ]
      },
      {
        "from": "../extension",
        "to": "station/extension",
        "filter": [
          "content-yuanbao.js",
          "manifest.json",
          "icons/**"
        ]
      },
      {
        "from": "../vendor",
        "to": "station/vendor",
        "filter": [
          "**/*",
          "!python/**",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/*.log"
        ]
      },
      {
        "from": "../vendor/python",
        "to": "py",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "asar": true
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

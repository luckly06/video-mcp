.workbuddy/
CRVideoMate/
station/vendor/*
# watermarks 水印配置（.ini 文本）需入库：CI 打包时没有本机 vendor，靠仓库内文件
!station/vendor/watermarks/
!station/vendor/watermarks/*
# 离线 ASR 模型（paraformer-zh-small，约 78 MiB）随包分发：CI 无本机模型目录，靠仓库内文件
# 单文件 model.int8.onnx 约 81.8MB，低于 GitHub 100MB 硬限制，可直接入库
!station/vendor/asr_models/
!station/vendor/asr_models/**
station/assets/**/*.mp4
input/*
!input/.gitkeep
output/*
!output/.gitkeep
station/logs/*
!station/logs/.gitkeep
station/server/logs/
station/server/.env
.claude/settings.local.json
**/.claude/settings.local.json
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/
station/_exp_*.py
station/_diag_*.py
station/_smoke_*.py

# === 2026-08-12 补充 ===
# 大型模型包（应放 OSS / HuggingFace）
*.tar.gz
*.zip

# 根目录临时测试脚本（应归到 tests/ 或 archive/）
/test_*.py

# === 2026-08-12 补充：Electron 桌面壳 ===
station/desktop/node_modules/
station/desktop/dist/
station/desktop/out/
station/desktop/logs/
station/desktop/build/runtime-config.bin
station/desktop/.electron-builder-cache/
